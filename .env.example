# Local personal lab only. Copy to .env and set your own password (12+ characters).
# Keep .env out of Git. The panel stays disabled until a password is configured.
FLAGS_ADMIN_PASSWORD=
APP_ENV=LOCAL
PORT=3000
FEATURE_BULK_DISCOUNT=false
DEMO_FAULT=none
# Optional: defaults to data/<environment>-flags.json.
# FLAGS_FILE=/absolute/path/to/local-flags.json
A=B
C=D
